# ==========================================
# SGR-UNIKIN - Configuration Production
# ==========================================

# Base de données PostgreSQL (Supabase, Neon, Railway, etc.)
DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:5432/[DATABASE]"

# NextAuth.js
NEXTAUTH_SECRET="votre-secret-tres-securise-genere-avec-openssl"
NEXTAUTH_URL="https://votre-domaine.vercel.app"

# ==========================================
# INSTRUCTIONS DE CONFIGURATION
# ==========================================
# 
# 1. Créez une base PostgreSQL sur votre provider (Supabase, Neon, Railway, etc.)
# 2. Récupérez le Connection string PostgreSQL
# 3. Remplacez DATABASE_URL par votre connection string
#
# ==========================================
# POUR GÉNÉRER NEXTAUTH_SECRET:
# ==========================================
# Exécutez: openssl rand -base64 32
# Ou utilisez: https://generate-secret.vercel.app/32

# ==========================================
# INITIALISATION DE LA BASE DE DONNÉES
# ==========================================
# Exécutez le script scripts/init-db.sql sur votre base PostgreSQL
# psql $DATABASE_URL -f scripts/init-db.sql

# ==========================================
# CONFIGURATION SMTP (Google Workspace)
# ==========================================
# Configuration Email (Resend - https://resend.com)
# Créez un compte gratuit sur resend.com et récupérez votre clé API
RESEND_API_KEY="re_votre_cle_api"
# En mode gratuit: onboarding@resend.dev
# Avec domaine vérifié: SGR-UNIKIN <sg.recherche@unikin.ac.cd>
EMAIL_FROM="SGR-UNIKIN <onboarding@resend.dev>"
