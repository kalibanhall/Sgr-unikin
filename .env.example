# ==========================================
# SGR-UNIKIN - Variables d'environnement
# ==========================================

# Base de données PostgreSQL
# Pour développement local:
DATABASE_URL="postgresql://postgres:password@localhost:5432/sgr_unikin"

# Pour production (Supabase/PostgreSQL):
# DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Pour VPS avec Docker Compose:
# DATABASE_URL="postgresql://sgr_unikin:MOT_DE_PASSE@db:5432/sgr_unikin"

# Variables Docker PostgreSQL (VPS uniquement)
POSTGRES_USER=sgr_unikin
POSTGRES_PASSWORD=CHANGEZ_CE_MOT_DE_PASSE
POSTGRES_DB=sgr_unikin

# NextAuth.js
# Générez avec: openssl rand -base64 32
NEXTAUTH_SECRET="votre-secret-genere-avec-openssl"
NEXTAUTH_URL="http://localhost:3000"

# En production, changez NEXTAUTH_URL par votre domaine:
# NEXTAUTH_URL="https://sgr.unikin.ac.cd"

# Configuration Email (Resend - https://resend.com)
RESEND_API_KEY="re_votre_cle_api"
EMAIL_FROM="SGR-UNIKIN <onboarding@resend.dev>"

# Dossier uploads (VPS)
UPLOAD_DIR=/app/uploads

# Domaine (pour le script de déploiement VPS)
DOMAIN=sgr.unikin.ac.cd
CERT_EMAIL=sg.recherche@unikin.ac.cd
